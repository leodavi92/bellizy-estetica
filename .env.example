# ============================================================
# EXEMPLO DE VARIÁVEIS DE AMBIENTE — Musa Agenda
# Copie este arquivo para .env.local e preencha com seus valores.
# NUNCA versionado o arquivo .env.local com valores reais.
# ============================================================

# Supabase Configuration
VITE_SUPABASE_URL=SUA_URL_SUPABASE_AQUI
VITE_SUPABASE_ANON_KEY=SUA_ANON_KEY_SUPABASE_AQUI

# Firebase Configuration
VITE_FIREBASE_API_KEY=SUA_API_KEY_FIREBASE_AQUI
VITE_FIREBASE_AUTH_DOMAIN=SEU_AUTH_DOMAIN_FIREBASE_AQUI
VITE_FIREBASE_PROJECT_ID=SEU_PROJECT_ID_FIREBASE_AQUI
VITE_FIREBASE_STORAGE_BUCKET=SEU_STORAGE_BUCKET_FIREBASE_AQUI
VITE_FIREBASE_MESSAGING_SENDER_ID=SEU_MESSAGING_SENDER_ID_AQUI
VITE_FIREBASE_APP_ID=SEU_APP_ID_FIREBASE_AQUI
VITE_FIREBASE_VAPID_KEY=SUA_VAPID_KEY_FCM_AQUI

# Mercado Pago Configuration (SaaS)
# A Public Key é usada no frontend para inicializar o checkout.
VITE_MERCADO_PAGO_PUBLIC_KEY=SUA_PUBLIC_KEY_MERCADO_PAGO_AQUI
VITE_SUBSCRIPTION_API_URL=SUA_URL_DA_FUNCTION_createSubscriptionPreference_AQUI

# O Access Token NUNCA deve ser exposto no frontend (VITE_).
# Ele deve ser usado apenas em funções backend ou serverless para criar preferências de pagamento.
# MP_SECRET_ACCESS_TOKEN=SEU_ACCESS_TOKEN_MERCADO_PAGO_AQUI
# MP_WEBHOOK_URL=SUA_URL_DA_FUNCTION_mercadopagoWebhook_AQUI

# Cloud Functions Backend (functions/index.js)
# RESEND_API_KEY=SUA_API_KEY_RESEND_PARA_EMAILS_TRANSACIONAIS_AQUI
# FUNCTION_REGION=southamerica-east1
# APP_URL=https://seu-dominio-musa-agenda.com.br
