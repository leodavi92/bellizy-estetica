rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // FUNÇÕES AUXILIARES CENTRALIZADAS
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function userType() {
      return isSignedIn() && getUserData() != null ? getUserData().tipo : null;
    }

    function userEstablishmentId() {
      return isSignedIn() && getUserData() != null ? getUserData().establishment_id : null;
    }

    function isOwnerOfEstablishment(estId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/establishments/$(estId))
        && get(/databases/$(database)/documents/establishments/$(estId)).data.owner_id == request.auth.uid;
    }

    function isAdminOrStaff(targetEstablishmentId) {
      return isSignedIn() && (
        (targetEstablishmentId != null && isOwnerOfEstablishment(targetEstablishmentId)) ||
        (userType() in ['admin', 'staff'] && userEstablishmentId() == targetEstablishmentId)
      );
    }

    function isOwnerAppointment() {
      return isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    function isRequestOwnerAppointment() {
      return isSignedIn() && request.resource.data.user_id == request.auth.uid;
    }

    // Firestore Rules expõem apenas limit/offset/orderBy em request.query — NÃO where.
    // Leituras de catálogo usam regras por documento alinhadas aos filtros do app.
    function isSelfProfessionalInvite() {
      return isSignedIn()
        && request.auth.token.email != null
        && (
          resource.data.email == request.auth.token.email
          || resource.data.get('e-mail', '') == request.auth.token.email
        );
    }

    function isPublicCatalogDoc() {
      return resource.data.establishment_id != null
        && resource.data.establishment_id.size() > 0
        && resource.data.establishment_id.size() <= 120;
    }

    function changedKeysOnlyAllowed(allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys()
        .toSet().difference(allowedKeys.toSet()).size() == 0;
    }

    // ============================================================
    // VALIDAÇÕES GENÉRICAS (V1 — Server-Side Schema Validation)
    // ============================================================

    // Garante que o valor é um Timestamp válido
    function isTimestamp(value) {
      return value is timestamp;
    }

    // Garante que um número NÃO É NEGATIVO
    function isNonNegativeNumber(value) {
      return value is number && value >= 0;
    }

    // Garante que uma string tem tamanho entre [min..max]
    function stringLen(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function onlyAllowedKeys(data, allowedKeys) {
      return data.keys().toSet().difference(allowedKeys.toSet()).size() == 0;
    }

    // Validacoes individuais de campos imutaveis (nao podem ser alterados por user comum)
    // Bloqueia mudancas em `tipo` (cliente -> admin) e `establishment_id` (sequestro de estab)
    // EXCECAO: permite upgrade cliente->admin se establishment_id sair de null e for do usuario
    function sensitiveUserFieldsUnchangedOrValidPromotion() {
      let oldTipo = resource.data.tipo is string ? resource.data.tipo : null;
      let newTipo = request.resource.data.tipo is string ? request.resource.data.tipo : null;
      let oldEstab = resource.data.establishment_id is string ? resource.data.establishment_id : null;
      let newEstab = request.resource.data.establishment_id is string ? request.resource.data.establishment_id : null;
      let sameFields = (oldTipo == newTipo && oldEstab == newEstab);
      let validPromotion = (oldTipo == 'cliente')
        && (newTipo == 'admin')
        && (oldEstab == null)
        && (newEstab != null)
        && isOwnerOfEstablishment(newEstab);
      return sameFields || validPromotion;
    }

    // Valida que os campos de subscription e plano NÃO podem ser alterados pelo DONO do estab (apenas Cloud Functions com admin SDK pode mudar)
    // ATENÇÃO: Firestore Rules NÃO suporta == profundo em objetos/arrays.
    // Por isso comparamos apenas os campos escalares de topo que realmente definem o plano.
    // Campos objeto subscription.details/status permitem mudança (apenas internamente).
    function subscriptionFieldsUnchanged() {
      let oldPlan = (resource.data.plan is string) ? resource.data.plan : null;
      let newPlan = (request.resource.data.plan is string) ? request.resource.data.plan : null;
      let oldStatus = (resource.data.subscription is map) && (resource.data.subscription.status is string)
        ? resource.data.subscription.status
        : null;
      let newStatus = (request.resource.data.subscription is map) && (request.resource.data.subscription.status is string)
        ? request.resource.data.subscription.status
        : null;
      let oldPlanId = (resource.data.subscription is map) && (resource.data.subscription.planId is string)
        ? resource.data.subscription.planId
        : null;
      let newPlanId = (request.resource.data.subscription is map) && (request.resource.data.subscription.planId is string)
        ? request.resource.data.subscription.planId
        : null;
      return oldPlan == newPlan && oldStatus == newStatus && oldPlanId == newPlanId;
    }

    // ============================================================
    // RATE LIMIT POR USUÁRIO (V2 — Anti-Spam / DoS em Writes)
    // LÊ o último write registrado em `users/{uid}.last_write_ts`.
    // Mínimo 6s entre writes (≈ 10 writes/min/usuário).
    //
    // SEMântica:
    //  - Admin/Staff = isentos (taxa de escrita interna é alta).
    //  - Não logados = bloqueados (não precisa de rate limit, já é bloqueado).
    //  - Usuário com last_write_ts nulo = sempre passa (1ª escrita, legados ainda não atualizaram o campo).
    //  - Caso geral: intervalo >= 6000 ms.
    // ============================================================

    function hasRateLimit() {
      return (isSignedIn() && userType() in ['admin', 'staff']) || (
        isSignedIn() && (
          getUserData() == null ||
          getUserData().last_write_ts == null ||
          request.time.toMillis() - getUserData().last_write_ts.toMillis() >= 6000
        )
      );
    }

    // ============================================================
    // 1. USERS — Somente o próprio usuário lê/escreve seus dados
    //    Campos permitidos whitelistados para bloquear lixo
    // ============================================================

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId
        && onlyAllowedKeys(request.resource.data, [
             'uid', 'nome', 'email', 'tipo', 'estabelecimento_ids',
             'establishment_id', 'avatar_url', 'fcm_tokens', 'fcmTokens', 'pushEnabled',
             'createdAt', 'last_write_ts', 'telefone', 'owner_email',
             'requirePasswordChange', 'aceitou_lgpd_em', 'aceitou_lgpd_version',
             'professional_id', 'saved_establishments', 'last_establishment_slug',
             'photoURL', 'updatedAt'
           ]);
      allow update, delete: if isSignedIn() && request.auth.uid == userId
        && sensitiveUserFieldsUnchangedOrValidPromotion()
        && onlyAllowedKeys(request.resource.data, [
             'uid', 'nome', 'email', 'tipo', 'estabelecimento_ids',
             'establishment_id', 'avatar_url', 'fcm_tokens', 'fcmTokens', 'pushEnabled',
             'createdAt', 'last_write_ts', 'telefone', 'owner_email',
             'requirePasswordChange', 'aceitou_lgpd_em', 'aceitou_lgpd_version',
             'professional_id', 'saved_establishments', 'last_establishment_slug',
             'photoURL', 'updatedAt'
           ]);
    }

    // ============================================================
    // 2. ESTABELECIMENTOS — Leitura pública (minisite). Escrita só dono.
    // Campos permitidos no onboarding/configuração (bloqueia subscrição)
    // ============================================================

    function allowedEstablishmentKeys() {
      return [
        'name','nome','slug','telefone','phone','owner_id',
        'endereco','address','descricao','description','photoURL','logo_url','banner_url',
        'instagram','horario_funcionamento','politica_cancelamento',
        'createdAt','profile_completed','setup_steps',
        'settings','business_settings','minisite_settings',
        'horario_inicio','horario_fim','dias_trabalho',
        'professionalName','especialidades',
        'aceita_cartao','aceita_pix','outras_formas_pagamento',
        'tem_estacionamento','tem_wifi','publico_alvo','ambiente',
        'plan','subscription','last_write_ts'
      ];
    }

    match /establishments/{estId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.owner_id == request.auth.uid
        && stringLen(request.resource.data.name, 0, 120)
        && onlyAllowedKeys(request.resource.data, allowedEstablishmentKeys())
        && hasRateLimit();
      allow update, delete: if isSignedIn() && resource.data.owner_id == request.auth.uid
        && subscriptionFieldsUnchanged()
        && changedKeysOnlyAllowed(allowedEstablishmentKeys())
        && hasRateLimit();
    }

    // ============================================================
    // 3. SERVIÇOS — Validação Server-Side
    // ============================================================

    match /services/{serviceId} {
      // Catálogo público por estabelecimento (minisite / agendamento sem login)
      allow read: if isPublicCatalogDoc();
      allow create: if isAdminOrStaff(request.resource.data.establishment_id)
        && userType() == 'admin'
        && stringLen(request.resource.data.nome, 2, 120)
        && isNonNegativeNumber(request.resource.data.preco)
        && request.resource.data.preco <= 99999.99
        && isNonNegativeNumber(request.resource.data.duracao)
        && request.resource.data.duracao <= 720  // Máx 12h
        && (
             request.resource.data.descricao == null ||
             stringLen(request.resource.data.descricao, 0, 2000)
           )
        && hasRateLimit();

      allow update, delete: if isAdminOrStaff(resource.data.establishment_id)
        && userType() == 'admin'
        && hasRateLimit();
    }

    // ============================================================
    // 4. PROFISSIONAIS — Validação Server-Side
    // ============================================================

    match /professionals/{profId} {
      // Equipe pública no agendamento OU convite vinculado ao e-mail autenticado
      allow read: if isPublicCatalogDoc() || isSelfProfessionalInvite();
      allow create: if isAdminOrStaff(request.resource.data.establishment_id)
        && userType() == 'admin'
        && stringLen(request.resource.data.nome, 2, 120)
        && (
             request.resource.data.especialidade == null ||
             stringLen(request.resource.data.especialidade, 0, 120)
           )
        && hasRateLimit();

      allow update, delete: if isAdminOrStaff(resource.data.establishment_id)
        && userType() == 'admin'
        && hasRateLimit();
    }

    // ============================================================
    // 5. NOTIFICAÇÕES — Anti-Spam + Validação
    //    Campos suportados: title + message (código novo) OU body (legado)
    // ============================================================

    match /notifications/{notifId} {
      allow read: if isSignedIn() && (
        (isAdminOrStaff(resource.data.establishment_id)) ||
        (resource.data.user_id == request.auth.uid) ||
        (resource.data.professional_id == request.auth.uid)
      );
      allow create: if isAdminOrStaff(request.resource.data.establishment_id)
        && stringLen(request.resource.data.title, 2, 200)
        && (
             // Suporta tanto o campo `message` (novo) quanto `body` (legado)
             (request.resource.data.message is string && stringLen(request.resource.data.message, 1, 2000)) ||
             (request.resource.data.body is string && stringLen(request.resource.data.body, 0, 2000))
           )
        && hasRateLimit();
      allow update, delete: if isSignedIn() && (
        (isAdminOrStaff(resource.data.establishment_id)) ||
        (resource.data.user_id == request.auth.uid) ||
        (resource.data.professional_id == request.auth.uid)
      ) && hasRateLimit();
    }

    // ============================================================
    // 6. CLIENTES MANUAIS — Validação Server-Side
    // ============================================================

    match /manual_clients/{clientId} {
      allow read: if isAdminOrStaff(resource.data.establishment_id);
      allow create: if isAdminOrStaff(request.resource.data.establishment_id)
        && stringLen(request.resource.data.nome, 2, 120)
        && (
             request.resource.data.telefone == null ||
             stringLen(request.resource.data.telefone, 7, 30)
           )
        && (
             request.resource.data.email == null ||
             stringLen(request.resource.data.email, 3, 150)
           )
        && hasRateLimit();
      allow update, delete: if isAdminOrStaff(resource.data.establishment_id)
        && hasRateLimit();
    }

    // ============================================================
    // 7. TRANSAÇÕES (Financeiro) — Validação Server-Side
    //    Campos: amount (legado) OU total_value (novo/padrão real do app)
    // ============================================================

    match /transactions/{txId} {
      allow read: if isAdminOrStaff(resource.data.establishment_id);
      allow create: if isAdminOrStaff(request.resource.data.establishment_id)
        && (
             // Campo antigo (amount) OU novo campo (total_value) — ambos devem ser números válidos
             (request.resource.data.amount is number &&
              request.resource.data.amount >= -999999.99 &&
              request.resource.data.amount <= 999999.99)
             ||
             (request.resource.data.total_value is number &&
              request.resource.data.total_value >= -999999.99 &&
              request.resource.data.total_value <= 999999.99)
           )
        && (
             request.resource.data.description == null ||
             stringLen(request.resource.data.description, 0, 500)
           )
        && isTimestamp(request.resource.data.createdAt)
        && hasRateLimit();
      allow update, delete: if isAdminOrStaff(resource.data.establishment_id)
        && hasRateLimit();
    }

    // ============================================================
    // 8. DESPESAS — Validação Server-Side
    // ============================================================

    match /expenses/{expId} {
      allow read: if isAdminOrStaff(resource.data.establishment_id);
      allow create: if isAdminOrStaff(request.resource.data.establishment_id)
        && isNonNegativeNumber(request.resource.data.value)
        && request.resource.data.value <= 999999.99
        && stringLen(request.resource.data.description, 2, 500)
        && hasRateLimit();
      allow update, delete: if isAdminOrStaff(resource.data.establishment_id)
        && hasRateLimit();
    }

    // ============================================================
    // 9. LEMBRETES — Validação Server-Side
    // ============================================================

    match /reminders/{remId} {
      allow read: if isAdminOrStaff(resource.data.establishment_id);
      allow create: if isAdminOrStaff(request.resource.data.establishment_id)
        && stringLen(request.resource.data.message, 0, 10000)
        && hasRateLimit();
      allow update, delete: if isAdminOrStaff(resource.data.establishment_id);
    }

    // ============================================================
    // 10. MODELOS DE ANAMNESE
    // ============================================================

    match /anamnesis_templates/{templateId} {
      allow read: if isAdminOrStaff(resource.data.establishment_id);
      allow create: if isAdminOrStaff(request.resource.data.establishment_id)
        && stringLen(request.resource.data.name, 2, 120)
        && hasRateLimit();
      allow update, delete: if isAdminOrStaff(resource.data.establishment_id)
        && hasRateLimit();
    }

    // ============================================================
    // 11. RESPOSTAS DE ANAMNESE — Dados extremamente sensíveis.
    //     Validação: tamanho máximo de payload para não DoS
    // ============================================================

    match /anamnesis_responses/{responseId} {
      allow read: if isSignedIn() && (
        (isAdminOrStaff(resource.data.establishment_id)) ||
        (resource.data.user_id == request.auth.uid) ||
        (resource.data.customer_id == request.auth.uid)
      );
      allow create: if isSignedIn()
        && request.resource.data.establishment_id != null
        && request.resource.data.establishment_id.size() <= 120
        && (
             (isAdminOrStaff(request.resource.data.establishment_id)) ||
             (request.resource.data.user_id == request.auth.uid) ||
             (request.resource.data.customer_id == request.auth.uid)
           )
        && hasRateLimit();

      allow update, delete: if isSignedIn() && (
        (isAdminOrStaff(resource.data.establishment_id)) ||
        (resource.data.user_id == request.auth.uid) ||
        (resource.data.customer_id == request.auth.uid)
      ) && hasRateLimit();
    }

    // ============================================================
    // 12. AGENDAMENTOS — CORREÇÃO CRÍTICA LGPD + VALIDAÇÃO (V1)
    //     Validações:
    //       - total_duration ≤ 720 min (12h)
    //       - total_price ≤ 99999.99 (sem negativo via update)
    //       - services ≤ 20 itens por combo (DoS)
    //       - start_time / end_time Timestamps válidos
    //       - user_id preenchido
    // ============================================================

    match /appointments/{appId} {
      allow read: if isSignedIn() && (
        isAdminOrStaff(resource.data.establishment_id) ||
        isOwnerAppointment()
      );

      allow create: if isSignedIn()
        && request.resource.data.establishment_id != null
        && (
             isRequestOwnerAppointment() ||
             isAdminOrStaff(request.resource.data.establishment_id)
           )
        && isTimestamp(request.resource.data.start_time)
        && isTimestamp(request.resource.data.end_time)
        && isNonNegativeNumber(request.resource.data.total_duration)
        && request.resource.data.total_duration <= 720
        && isNonNegativeNumber(request.resource.data.total_price)
        && request.resource.data.total_price <= 99999.99
        && (
             request.resource.data.user_nome == null ||
             stringLen(request.resource.data.user_nome, 2, 120)
           )
        && (
             request.resource.data.user_telefone == null ||
             stringLen(request.resource.data.user_telefone, 7, 30)
           )
        && (
             request.resource.data.services is list &&
             request.resource.data.services.size() <= 20
           )
        && hasRateLimit();

      allow update: if isSignedIn() && (
        isAdminOrStaff(resource.data.establishment_id) ||
        isOwnerAppointment()
      ) && (
        request.resource.data.total_duration <= 720
      ) && (
        request.resource.data.total_price >= 0 &&
        request.resource.data.total_price <= 99999.99
      ) && (
        request.resource.data.services is list &&
        request.resource.data.services.size() <= 20
      ) && hasRateLimit();

      allow delete: if isSignedIn() && (
        isAdminOrStaff(resource.data.establishment_id) ||
        isOwnerAppointment()
      ) && hasRateLimit();
    }
  }
}